{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InventoryCatalogContract",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "sku": { "type": "string" },
    "barcode": { "type": "string" },
    "name": { "type": "string" },
    "category": { "type": "string" },
    "unit": { "type": "string" },
    "minStockThreshold": { "type": "number" },
    "unitPrice": { "type": "number" },
    "compatibleModels": { "type": "array", "items": { "type": "string" } },
    "isActive": { "type": "boolean" }
  },
  "required": ["id", "sku", "barcode", "name", "category", "unit", "isActive"]
}
